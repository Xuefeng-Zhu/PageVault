{
  "name": "PageVault Dev",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "installOhMyZsh": false,
      "installOhMyZshConfig": false
    }
  },
  "onCreateCommand": {
    "label": "Bootstrap PageVault dev environment",
    "command": "bash scripts/dev-setup.sh"
  },
  "postCreateCommand": {
    "label": "Smoke-check the toolchain",
    "command": "node --version && npm --version && npm run typecheck"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-playwright.playwright",
        "vitest.explorer"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "files.eol": "\n",
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    },
    "codespaces": {
      "openFiles": ["README.md"],
      "repositories": {
        "defaultBranch": "main"
      },
      "machineType": "standardLinux32gb"
    }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Next.js dev server",
      "onAutoForward": "notify",
      "protocol": "http",
      "description": "PageVault web app (dev mode)"
    }
  },
  "containerUser": "node",
  "remoteUser": "node",
  "remoteEnv": {
    "NODE_ENV": "development",
    "PATH": "/home/node/.local/share/pnpm:/usr/local/share/npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  },
  "mounts": [
    "source=pagevault-node_modules,target=/home/node/pagevault/node_modules,type=volume,consistency=cached"
  ],
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  }
}
