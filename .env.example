# PageVault Environment Variables
# Copy this file to .env.local and fill in your values.
# Missing credentials enable Demo Mode (the app runs with mock data).

# ─── Insforge (Postgres via @insforge/sdk) ───────────────────────────────────
# Required for production. Without these, the app runs in Demo Mode with InsforgeUnavailableError.
INSFORGE_API_URL=https://your-insforge-project.supabase.co
INSFORGE_SERVICE_ROLE_KEY=your-service-role-key-here
INSFORGE_ANON_KEY=your-anon-key-here


# === InsForge (browser-visible mirrors) ===
# The browser bundle can only see vars prefixed NEXT_PUBLIC_. Next.js
# inlines them at build time. Use these when client code (login page,
# dashboard) needs to call InsForge directly.
#
# NEXT_PUBLIC_INSFORGE_URL        - defaults to INSFORGE_API_URL if unset.
# NEXT_PUBLIC_INSFORGE_ANON_KEY   - REQUIRED for client-side calls and
#     safe to mirror from INSFORGE_ANON_KEY. The scan pipeline falls
#     back to INSFORGE_ANON_KEY on the server, but browser flows still
#     need this mirror.

NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=your-anon-key-here


# === NextAuth (login + session) ===
# NEXTAUTH_SECRET signs the session JWTs. There is no safe default - a
# hardcoded fallback would let anyone forge a session for the admin user
# (see SECURITY.md, finding S-2). The lib/auth.ts module throws at
# startup if this is unset, UNLESS the dev opt-in below is enabled.
#
# Generate with: openssl rand -base64 32
# Use a different secret per environment (dev / staging / prod).
#
# IMPORTANT: this ships EMPTY. A non-empty placeholder (e.g. "changeme")
# would be silently accepted by lib/auth.ts and would result in forgeable
# JWTs. The dev-setup.sh script auto-fills this for you in dev mode.
NEXTAUTH_SECRET=

# Canonical URL of this deployment. NextAuth uses it to build redirect
# URIs. Defaults to the request's Host header (and VERCEL_URL on
# Vercel), but set it explicitly when running behind a reverse proxy.
NEXTAUTH_URL=http://localhost:3000


# === Dev-only opt-ins (NEVER set in production) ===
# These flip a local-only mode in lib/auth.ts. The combination is what
# makes them safe: a misconfigured production deploy cannot accidentally
# enable them because BOTH the env var AND NODE_ENV=development must
# be true.
#
# INSFORGE_DEV_INSECURE_SECRET  - auto-generate a per-process random
#     NEXTAUTH_SECRET so the dev workflow works without committing a
#     real secret. Sessions are invalidated on every process restart -
#     that is the intended dev behaviour. NEVER set this in production.
#
# INSFORGE_DEV_DEMO_AUTH        - accept the demo credentials
#     (admin@example.com / demo123) on the login page. Used to seed
#     and click through the app before the real auth provider is wired.
#     NEVER set this in production.
#
# Both are set automatically by ./scripts/dev-setup.sh on a fresh clone
# (when .env.local didn't already exist), so `npm run dev` boots
# end-to-end without requiring the operator to generate secrets first.
# Comment them out and provide real NEXTAUTH_SECRET / NEXTAUTH_URL
# for any environment that needs stable sessions.

# INSFORGE_DEV_INSECURE_SECRET=
# INSFORGE_DEV_DEMO_AUTH=


# === Apify (web crawl) ===
# Apify runs the website-content-crawler actor on the room's URLs and
# returns a markdown snapshot for each. When these are unset, lib/scan.ts
# falls back to a direct fetch + HTML-to-Markdown extractor - that path
# works but does NOT render JavaScript and can be blocked by anti-bot
# defences.
#
# Get a token at https://console.apify.com/account/integrations
# Pick an actor at https://console.apify.com/actors. API URLs use the
# `username~actor-name` form; the scan code also normalizes slashes.
#
# BOTH must be set. If only one is set, the scan code treats it the
# same as neither (no error, just falls through to the direct-fetch
# path).
APIFY_API_TOKEN=your-apify-token-here
APIFY_ACTOR_ID=apify~website-content-crawler

# Apify webhook auth. Used by functions/apify-webhook.ts (InsForge
# Edge Function) to authenticate the X-Shared-Secret header on
# incoming Apify completion webhooks. Leave empty if you don't deploy
# the webhook function.
APIFY_WEBHOOK_SECRET=


# === OpenAI-compatible LLM (change analysis) ===
# The change-analysis step calls an OpenAI-compatible Chat Completions
# endpoint. lib/scan.ts follows this key-selection logic:
#
#   1. If OPENAI_API_KEY is a real key (length >= 30, no `...` placeholder)
#      => use it with OPENAI_BASE_URL (default https://api.openai.com/v1)
#      and OPENAI_MODEL (default gpt-4o-mini).
#   2. Otherwise, if OPENROUTER_API_KEY is set => use it with the
#      OpenRouter base URL and a strong default model
#      (anthropic/claude-3.5-haiku).
#   3. Otherwise, the LLM call returns a deterministic mock analysis
#      derived from the URL hash (still useful for end-to-end UI testing).
#
# Get an OpenAI key at    https://platform.openai.com/api-keys
# Get an OpenRouter key at https://openrouter.ai/keys

# Pick ONE of these (or both - OPENAI_API_KEY wins when present).
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1  # or your custom endpoint
OPENAI_MODEL=gpt-4o-mini

# ─── InsForge Schedules (Cron) ───────────────────────────────────────────────
# Required for the scheduled-scans and notifications features. The
# cron endpoints (`/api/cron/scan-all`, `/api/cron/scan-room/[roomId]`,
# `/api/cron/notification-worker`) all check this header as
# `x-cron-secret`. The InsForge schedule must send the same value
# when registering.
CRON_SHARED_SECRET=

# ─── Evidence Bundle Export (US-008) ─────────────────────────────────────────
# Used by `/api/changes/[changeId]/export` to HMAC-SHA256 sign the
# manifest.json in each evidence bundle. Without this set, the
# export route returns 500 (the bundle refuses to ship without a
# signing secret). Generate with `openssl rand -base64 32`.
#
# Production rotation: the secret is read at request time, so a
# rolling deploy after editing .env.local picks up the new value
# without code changes. Bundles signed with the previous secret
# will fail verification — plan a coordinated rollover.
EVIDENCE_EXPORT_SIGNING_SECRET=
