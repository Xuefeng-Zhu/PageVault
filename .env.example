# PageVault Environment Variables
# Copy this file to .env.local and fill in your values.
# Missing credentials enable Demo Mode (the app runs with mock data).

# ─── Insforge (Postgres via @insforge/sdk) ───────────────────────────────────
# Required for production. Without these, the app runs in Demo Mode with InsforgeUnavailableError.
INSFORGE_API_URL=https://your-insforge-project.supabase.co
INSFORGE_SERVICE_ROLE_KEY=your-service-role-key-here
INSFORGE_ANON_KEY=your-anon-key-here

# ─── CRITICAL-2: opt-in dev demo auth ────────────────────────────────────────
# When set to "1" AND NODE_ENV=development, lib/auth.ts accepts
# `admin@example.com` / `demo123` as a local-only super-user. The same
# canonical owner_id (`00000000-0000-0000-0000-000000000001`) used by
# createRoom/migrateOwnerIds is returned, so the user owns every legacy
# project backfilled to that id.
#
# ⚠️  DO NOT SET THIS IN PRODUCTION. Both conditions are required to opt
# in, but a stray "1" in prod is a P0 auth bypass — the dev-only flag is
# only honored when NODE_ENV=development, so a production deploy will be
# rejected at module load if this is set there. Still: leave it unset.
#
# The login page (app/login/page.tsx) no longer advertises these creds.
# # INSFORGE_DEV_DEMO_AUTH=1

# ─── Apify (Web Crawling) ────────────────────────────────────────────────────
# Without these, crawl uses deterministic mock data.
APIFY_API_TOKEN=your-apify-token-here
APIFY_ACTOR_ID=your-actor-id-here

# Shared secret the Apify completion webhook must send in the
# `X-Shared-Secret` header. Required for the production
# `/functions/apify-webhook` edge function — without it the function
# refuses all requests with a 503 "service_unconfigured" response.
# Use a long random value, e.g. `openssl rand -base64 48`. The same
# value must be configured in the Apify webhook integration's
# "Shared secret" field.
APIFY_WEBHOOK_SECRET=chan...cret

# ─── OpenAI-Compatible LLM (Change Analysis) ─────────────────────────────────
# Without these, analysis uses deterministic mock results.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1  # or your custom endpoint
OPENAI_MODEL=gpt-4o-mini

# ─── InsForge Schedules (Cron) ───────────────────────────────────────────────
# Required for the scheduled-scans and notifications features. The
# cron endpoints (`/api/cron/scan-all`, `/api/cron/scan-room/[roomId]`,
# `/api/cron/notification-worker`) all check this header as
# `x-cron-secret`. The InsForge schedule must send the same value
# when registering.
CRON_SHARED_SECRET=any-lo...ring            # must match what the
                                            # InsForge schedule sends
