# PageVault - Environment Variables (source of truth).
#
# Copy this file to .env.local and fill in your values:
#
#     cp .env.example .env.local
#
# .env.local is gitignored. NEVER commit it. NEVER paste real keys into
# this file - it is committed to the repo, and any real secret would be
# pushed to the public history.
#
# For the full per-variable contract (effects of missing keys, fail-closed
# behaviour, where to get each key) see docs/ENVIRONMENT.md. For the local
# workflow see docs/DEVELOPMENT.md. For a one-command bootstrap, run
# ./scripts/dev-setup.sh (or open the repo in GitHub Codespaces, which
# runs the same script via .devcontainer/devcontainer.json).
#
# Quick summary of how the app reacts to missing keys:
#   INSFORGE_*         REQUIRED. lib/env.ts throws at startup without them.
#   NEXTAUTH_SECRET    REQUIRED. lib/auth.ts throws at startup unless the
#                      dev opt-in INSFORGE_DEV_INSECURE_SECRET is set
#                      AND NODE_ENV=development. A placeholder value here
#                      would be silently accepted (and would be a real
#                      security footgun), so the example ships EMPTY.
#   APIFY_*            OPTIONAL. Missing => lib/scan.ts falls back to a
#                      direct fetch + HTML-to-Markdown baseline crawler.
#   OPENAI_*           OPTIONAL. Missing or placeholder => the LLM call
#                      uses a deterministic mock unless OPENROUTER_API_KEY
#                      is set.
#   CRON_SHARED_SECRET REQUIRED for the scheduled-scan / notification
#                      worker endpoints. Without it, cron requests get
#                      503 service_unconfigured. Ships EMPTY for the
#                      same reason as NEXTAUTH_SECRET.
#   NEXT_PUBLIC_*      Exposed to the browser bundle. NEVER put a
#                      service-role key here.
#   INSFORGE_DEV_*     DEV-ONLY opt-ins. NEVER set in production. The
#                      dev-setup.sh script sets them automatically on a
#                      fresh clone so npm run dev boots end-to-end.
#
# Generate secrets with:
#     NEXTAUTH_SECRET        openssl rand -base64 32
#     CRON_SHARED_SECRET     openssl rand -hex 32


# === InsForge (Postgres + Storage + Schedules) ===
# The single backend for everything PageVault persists: rooms, watched
# URLs, snapshots, AI explanations, scheduled-scan rows, notification
# outbox, and the evidence storage bucket (pagevault-evidence).
#
# Get these from your InsForge project:
#   1. Sign in at https://insforge.dev
#   2. Open or create the project you want to point at
#   3. The API URL, anon key, and service-role key are on the project
#      dashboard (Settings -> API keys). The CLI command
#      `npx @insforge-cli@latest env pull` writes them to .insforge/,
#      but the app itself reads them from this file.
#
# The PageVault project is hosted at https://wga6k9at.us-east.insforge.app
# - the values below are placeholders. Replace them with real values.

# The InsForge project's REST base URL. No trailing slash. The app
# throws at startup if this is missing.
INSFORGE_API_URL=https://your-project.us-east.insforge.app

# Service-role key (full read/write). Used by the scan pipeline and
# cron workers for inserts and updates that bypass the SDK. NEVER expose
# to the browser - keep this server-side only.
INSFORGE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anon (publishable) key. Used by the @insforge/sdk client and by the
# storage SDK - the storage SDK is anon-key-only, so even when the
# service-role key is set, this one must be set too. Safe to mirror to
# the client side via NEXT_PUBLIC_INSFORGE_ANON_KEY below.
INSFORGE_ANON_KEY=your-anon-key-here


# === InsForge (browser-visible mirrors) ===
# The browser bundle can only see vars prefixed NEXT_PUBLIC_. Next.js
# inlines them at build time. Use these when client code (login page,
# dashboard) needs to call InsForge directly.
#
# NEXT_PUBLIC_INSFORGE_URL        - defaults to INSFORGE_API_URL if unset.
# NEXT_PUBLIC_INSFORGE_ANON_KEY   - REQUIRED for client-side calls. If
#     you don't need the SDK in the browser, you can leave this empty
#     and the client will fall back to server-proxied routes.

NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=


# === NextAuth (login + session) ===
# NEXTAUTH_SECRET signs the session JWTs. There is no safe default - a
# hardcoded fallback would let anyone forge a session for the admin user
# (see SECURITY.md, finding S-2). The lib/auth.ts module throws at
# startup if this is unset, UNLESS the dev opt-in below is enabled.
#
# Generate with: openssl rand -base64 32
# Use a different secret per environment (dev / staging / prod).
#
# IMPORTANT: this ships EMPTY. A non-empty placeholder (e.g. "changeme")
# would be silently accepted by lib/auth.ts and would result in forgeable
# JWTs. The dev-setup.sh script auto-fills this for you in dev mode.
NEXTAUTH_SECRET=

# Canonical URL of this deployment. NextAuth uses it to build redirect
# URIs. Defaults to the request's Host header (and VERCEL_URL on
# Vercel), but set it explicitly when running behind a reverse proxy.
NEXTAUTH_URL=http://localhost:3000


# === Dev-only opt-ins (NEVER set in production) ===
# These flip a local-only mode in lib/auth.ts. The combination is what
# makes them safe: a misconfigured production deploy cannot accidentally
# enable them because BOTH the env var AND NODE_ENV=development must
# be true.
#
# INSFORGE_DEV_INSECURE_SECRET  - auto-generate a per-process random
#     NEXTAUTH_SECRET so the dev workflow works without committing a
#     real secret. Sessions are invalidated on every process restart -
#     that is the intended dev behaviour. NEVER set this in production.
#
# INSFORGE_DEV_DEMO_AUTH        - accept the demo credentials
#     (admin@example.com / demo123) on the login page. Used to seed
#     and click through the app before the real auth provider is wired.
#     NEVER set this in production.
#
# Both are set automatically by ./scripts/dev-setup.sh on a fresh clone
# (when .env.local didn't already exist), so `npm run dev` boots
# end-to-end without requiring the operator to generate secrets first.
# Comment them out and provide real NEXTAUTH_SECRET / NEXTAUTH_URL
# for any environment that needs stable sessions.

# INSFORGE_DEV_INSECURE_SECRET=
# INSFORGE_DEV_DEMO_AUTH=


# === Apify (web crawl) ===
# Apify runs the website-content-crawler actor on the room's URLs and
# returns a markdown snapshot for each. When these are unset, lib/scan.ts
# falls back to a direct fetch + HTML-to-Markdown extractor - that path
# works but does NOT render JavaScript and can be blocked by anti-bot
# defences.
#
# Get a token at https://console.apify.com/account/integrations
# Pick an actor at https://console.apify.com/actors (we recommend
# apify/website-content-crawler).
#
# BOTH must be set. If only one is set, the scan code treats it the
# same as neither (no error, just falls through to the direct-fetch
# path).
APIFY_API_TOKEN=your-apify-token-here
APIFY_ACTOR_ID=apify/website-content-crawler

# Apify webhook auth. Used by functions/apify-webhook.ts (InsForge
# Edge Function) to authenticate the X-Shared-Secret header on
# incoming Apify completion webhooks. Leave empty if you don't deploy
# the webhook function.
APIFY_WEBHOOK_SECRET=


# === OpenAI-compatible LLM (change analysis) ===
# The change-analysis step calls an OpenAI-compatible Chat Completions
# endpoint. lib/scan.ts follows this key-selection logic:
#
#   1. If OPENAI_API_KEY is a real key (length >= 30, no `...` placeholder)
#      => use it with OPENAI_BASE_URL (default https://api.openai.com/v1)
#      and OPENAI_MODEL (default gpt-4o-mini).
#   2. Otherwise, if OPENROUTER_API_KEY is set => use it with the
#      OpenRouter base URL and a strong default model
#      (anthropic/claude-3.5-haiku).
#   3. Otherwise, the LLM call returns a deterministic mock analysis
#      derived from the URL hash (still useful for end-to-end UI testing).
#
# Get an OpenAI key at    https://platform.openai.com/api-keys
# Get an OpenRouter key at https://openrouter.ai/keys

# Pick ONE of these (or both - OPENAI_API_KEY wins when present).
OPENAI_API_KEY=your-openai-api-key-here

# Optional overrides. Defaults shown.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# OpenRouter fallback key. When OPENAI_API_KEY is a placeholder
# (length < 30 or contains `...`), lib/scan.ts will pick this up and
# route the LLM call through OpenRouter (https://openrouter.ai/keys)
# with a strong default model (anthropic/claude-3.5-haiku). Useful
# when you don't have an OpenAI key but have an OpenRouter key. Leave
# blank to fall through to the deterministic mock analysis. Get a
# key at https://openrouter.ai/keys
OPENROUTER_API_KEY=


# === Cron worker auth ===
# The scheduled-scan and notification-dispatcher endpoints
# (/api/cron/scan-all, /api/cron/scan-room/[id],
# /api/cron/notification-worker) require an x-cron-secret header that
# matches this value. The InsForge Schedule that fires the cron is
# configured with the same secret in its --headers flag.
#
# If unset, all cron requests get 503 service_unconfigured - the
# schedule still fires but the work is rejected. This is a safe-by-
# default posture for unconfigured deployments (see lib/cron-auth.ts).
#
# Generate with: openssl rand -hex 32
# (a different secret per environment is fine but not required - cron
# auth is a server-to-server secret, not user-facing.)
#
# IMPORTANT: this ships EMPTY for the same security reason as
# NEXTAUTH_SECRET - a placeholder would be silently accepted as a
# real shared secret.
CRON_SHARED_SECRET=


# === App canonical URL (for InsForge Schedule callbacks) ===
# When the app creates an InsForge Schedule (POST /api/rooms + the
# schedule route), it points the schedule's HTTP target at this URL.
# Leave unset to use the default http://localhost:3000 (fine for local
# dev). In Vercel deploys, VERCEL_URL is auto-detected and used in
# preference.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# === Misc (rare) ===
# PORT - overrides the Next.js dev server port (default 3000). Used by
#   the schedule route when building the callback URL. Leave unset
#   unless you're running multiple Next.js processes on the same host.
PORT=3000
